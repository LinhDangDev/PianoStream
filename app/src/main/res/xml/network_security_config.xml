<?xml version="1.0" encoding="utf-8"?>
<!-- F7: cleartext off globally; trust system CAs only (no user-added CAs —
     protects the pinned registry calls and stream fetches alike). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
