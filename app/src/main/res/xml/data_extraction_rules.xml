<?xml version="1.0" encoding="utf-8"?>
<!-- F10: nothing leaves the device via Android's cloud/device-transfer
     backup channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
